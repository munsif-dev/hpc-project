\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces OpenMP shared-memory workflow. Model weights are shared and read-only during the parallel region; each thread writes only to its own private gradient buffer before the master performs one reduction and SGD update.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:omp}{{3}{4}{OpenMP shared-memory workflow. Model weights are shared and read-only during the parallel region; each thread writes only to its own private gradient buffer before the master performs one reduction and SGD update}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}POSIX Threads}{4}{subsection.4.2}\protected@file@percent }
\newlabel{sec:pthreads}{{4.2}{4}{POSIX Threads}{subsection.4.2}{}}
\newlabel{eq:pth-reduce}{{4}{4}{POSIX Threads}{equation.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Pthreads master/worker workflow. Workers live for the entire run; two barriers gate each mini-batch, and the master performs the gradient reduction and SGD update after all workers finish their slices.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:pth}{{4}{5}{Pthreads master/worker workflow. Workers live for the entire run; two barriers gate each mini-batch, and the master performs the gradient reduction and SGD update after all workers finish their slices}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}MPI (Distributed Memory)}{5}{subsection.4.3}\protected@file@percent }
\newlabel{sec:mpi}{{4.3}{5}{MPI (Distributed Memory)}{subsection.4.3}{}}
\newlabel{eq:mpi-reduce}{{5}{5}{MPI (Distributed Memory)}{equation.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces MPI distributed-memory workflow. Each rank owns a private model copy and local gradient; one packed \texttt  {MPI\_Allreduce(SUM)} synchronises the full gradient before every rank applies the same SGD update.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:mpi}{{5}{6}{MPI distributed-memory workflow. Each rank owns a private model copy and local gradient; one packed \texttt {MPI\_Allreduce(SUM)} synchronises the full gradient before every rank applies the same SGD update}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Hybrid MPI + OpenMP}{6}{subsection.4.4}\protected@file@percent }
\newlabel{sec:hybrid}{{4.4}{6}{Hybrid MPI + OpenMP}{subsection.4.4}{}}
\newlabel{eq:hyb-reduce}{{6}{6}{Hybrid MPI + OpenMP}{equation.4.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Hybrid MPI+OpenMP workflow. MPI performs the outer distributed-memory decomposition across ranks, OpenMP performs the inner shared-memory decomposition within each rank, and only the rank-local reduced gradients enter the MPI \texttt  {Allreduce}.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:hybrid_workflow}{{6}{7}{Hybrid MPI+OpenMP workflow. MPI performs the outer distributed-memory decomposition across ranks, OpenMP performs the inner shared-memory decomposition within each rank, and only the rank-local reduced gradients enter the MPI \texttt {Allreduce}}{figure.caption.7}{}}
